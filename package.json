{
  "name": "image-port-chrome",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:extension": "TEST_EXTENSION=1 node tests/browser.mjs",
    "check": "npm test && npm run build && npm run test:e2e && npm run test:workspace",
    "test:workspace": "node tests/workspace-browser.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "gifenc": "1.0.3",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.58.2"
  }
}
