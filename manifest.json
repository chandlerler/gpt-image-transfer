{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "图像港 · 批量图片转换",
  "version": "1.0.0",
  "description": "通过网页悬浮窗在本地批量转换图片、重命名并打包下载。",
  "action": { "default_title": "打开图像港" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["app.html", "app.js", "app.css"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' blob: data:; connect-src 'none'" }
}
